# Local development defaults for running the backend outside Docker.
# Copy to .env (git-ignored) and load it into your shell before `go run ./cmd/server`.
# docker compose up --build needs none of this; deploy/.env.production.example covers production.

# Run as the multi-tenant SaaS (the platform admin login below is only honoured in saas mode).
META_ORG_MODE=saas
META_ORG_ENVIRONMENT=development
SERVER_PORT=8080

# Platform control database and the admin connection used to create per-tenant databases.
# TENANT_DATABASE_ADMIN_URL must point at an admin database (postgres), never at the platform DB.
PLATFORM_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/meta_org_saas?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/meta_org_saas?sslmode=disable
TENANT_DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres?sslmode=disable

# Paths are relative to the backend/ working directory.
MIGRATIONS_PATH=../migrations
TENANT_MIGRATIONS_PATH=../migrations/tenant

# Development-only secrets. Production and saas-mode deployments outside
# META_ORG_ENVIRONMENT=test refuse the repository defaults, so set real values there.
JWT_SECRET=dev-jwt-secret-change-me-0123456789abcdef
MODEL_SECRET_KEY=0123456789abcdef0123456789abcdef
SECURITY_KERNEL_URL=http://127.0.0.1:8090
SECURITY_KERNEL_SHARED_SECRET=dev-security-kernel-shared-secret
SECURITY_KERNEL_ENFORCEMENT_MODE=blocking

# SaaS platform administrator. Generate the hash from backend/ with:
#   BCRYPT_PASSWORD='<password>' go run ./cmd/bcrypt-hash
META_ORG_PLATFORM_ADMIN_EMAIL=platform-admin@local.test
META_ORG_PLATFORM_ADMIN_PASSWORD_HASH=''

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_PROXY_CIDRS=

# Lets finance adapters and SMT edge instances target loopback/private hosts
# (local simulators). Defaults to true in development/test; keep false elsewhere.
OUTBOUND_ALLOW_PRIVATE_NETWORKS=true

# Optional: AI providers used by Business AI and document import.
BUSINESS_AI_PROVIDER_TYPE=
BUSINESS_AI_MODEL=
DOCUMENT_IMPORT_PROVIDER_TYPE=
DOCUMENT_IMPORT_MODEL=
