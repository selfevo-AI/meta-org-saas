# Use a hostname without a scheme, path, or port. DNS must point to this host.
APP_DOMAIN=app.example.com
ACME_EMAIL=ops@example.com

# Required secrets have no usable defaults. Keep the real .env file out of git.
POSTGRES_PASSWORD=
# Use URL-encoded credentials and the same PostgreSQL instance for both URLs.
PLATFORM_DATABASE_URL=
TENANT_DATABASE_ADMIN_URL=
JWT_SECRET=
MODEL_SECRET_KEY=
SECURITY_KERNEL_SHARED_SECRET=
META_ORG_PLATFORM_ADMIN_EMAIL=
# Surround the bcrypt hash with single quotes so Compose preserves its $ signs.
META_ORG_PLATFORM_ADMIN_PASSWORD_HASH=''

# This dedicated proxy address is the only trusted source of forwarded client IPs.
# Keep the proxy outside the dynamic range, with both inside the same subnet.
APP_NETWORK_SUBNET=172.30.40.0/24
APP_NETWORK_DYNAMIC_RANGE=172.30.40.128/25
PROXY_IP_ADDRESS=172.30.40.2
TENANT_DATABASE_POOL_MAX_ENTRIES=16
TENANT_DATABASE_POOL_MAX_CONNECTIONS=2

# Optional registered multimodal model for external-document recognition.
DOCUMENT_IMPORT_PROVIDER_TYPE=
DOCUMENT_IMPORT_MODEL=
