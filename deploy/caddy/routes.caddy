(app_routes) {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	@api path /api/v1 /api/v1/*
	handle @api {
		reverse_proxy backend:8080 {
			flush_interval -1
			header_up -Forwarded
			header_up X-Real-IP {remote_host}
		}
	}

	handle {
		reverse_proxy frontend:3000
	}
}
